# Copy to .env.local for local development. On the host, set these in the project's
# environment settings. Never put secrets in VITE_ variables: everything prefixed VITE_
# is bundled into public client code.

# "true" shows visible "Sample" labels on placeholder content and a preview notice.
# Set to "false" only after all placeholder content has been replaced and approved.
VITE_DEMO_MODE=true

# Public production URL (no trailing slash). Used for canonical links and sitemap later.
VITE_SITE_URL=

# --- Enquiry form ---------------------------------------------------------------
# Leave empty until a provider is set up: the form then explains that online enquiries
# are not connected yet, and never pretends to send.
#
# Formspree:  VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id   (no access key)
# Web3Forms:  VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
#             VITE_FORM_ACCESS_KEY=your-public-access-key
# Both are public values by design. Restrict them to your domain in the provider dashboard.
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
